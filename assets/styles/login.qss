/* Login artwork is 1672 x 941. Pixel sizes below use that design canvas.
   prepare_page_style scales them with loginRoot.styleScale in app and gallery.
   The image supplies the panels, gradients and decorative icons. */
QWidget#loginRoot { background: #082344; }
QWidget#loginRoot QLabel {
    background: transparent; border: none; padding: 0; margin: 0;
    color: #ffffff; font-size: 20px;
}
QWidget#loginRoot QLabel#brandTitle {
    font-size: 46px; font-weight: 800;
}
QWidget#loginRoot QLabel#brandAccent {
    color: #ffb348; font-size: 46px; font-weight: 800; font-style: italic;
}
QWidget#loginRoot QLabel#brandSubtitle {
    font-size: 21px; font-style: italic; color: #edf5ff;
}
QWidget#loginRoot QLabel#brandFeature {
    font-size: 19px; font-weight: 700;
}
QWidget#loginRoot QLabel#loginTitle {
    font-size: 33px; font-weight: 800;
}
QWidget#loginRoot QLabel#loginSubtitle {
    font-size: 19px; font-style: italic; color: #f2f7ff;
}
QWidget#loginRoot QLabel#fieldLabel {
    color: #071d43; font-size: 21px; font-weight: 600;
}

/* Transparent editors preserve the input backgrounds/icons in login.png. */
QWidget#loginRoot QLineEdit {
    background: transparent; color: #122c56;
    placeholder-text-color: #4b6690;
    border: 2px solid transparent; border-radius: 16px;
    padding: 0 16px 0 74px; min-height: 0;
    font-size: 22px; selection-background-color: #245f9b;
    selection-color: #ffffff;
}
QWidget#loginRoot QLineEdit#passwordInput { padding-right: 66px; }
QWidget#loginRoot QLineEdit:hover { border-color: #ffffff; }
QWidget#loginRoot QLineEdit:focus {
    background: rgba(255, 255, 255, 22); border-color: #1b6ac7;
}

QWidget#loginRoot QPushButton {
    background: transparent; color: #09234a;
    border: 2px solid transparent; border-radius: 10px;
    padding: 0; margin: 0; min-width: 0; min-height: 0;
    font-size: 21px; font-weight: 600;
}
QWidget#loginRoot QPushButton:hover { background: rgba(255, 255, 255, 35); }
QWidget#loginRoot QPushButton:pressed { background: rgba(9, 35, 74, 25); }
QWidget#loginRoot QPushButton:focus { border-color: #134d8b; }
/* Opaque backing replaces the eye already baked into the artwork. */
QWidget#loginRoot QPushButton#passwordToggle {
    background: #cce1f8; border-radius: 8px;
}
QWidget#loginRoot QPushButton#passwordToggle:hover { background: #e6f3ff; }
QWidget#loginRoot QPushButton#passwordToggle:checked { background: #cce1f8; }
QWidget#loginRoot QPushButton#passwordToggle:pressed { background: #b4d2f3; }
QWidget#loginRoot QPushButton#forgotButton {
    color: #005fc9; font-size: 19px; text-decoration: underline;
    font-weight: 500; text-align: right;
}
QWidget#loginRoot QPushButton#loginButton {
    color: #ffffff; font-size: 29px; font-weight: 800;
    border-radius: 22px; padding-left: 120px;
}
QWidget#loginRoot QPushButton#loginButton:focus { border-color: #ffffff; }
QWidget#loginRoot QPushButton#supportButton {
    font-size: 22px; font-weight: 700; padding-left: 60px; border-radius: 18px;
}
QWidget#loginRoot QPushButton:disabled { color: #697c94; background: rgba(30, 55, 85, 55); }

QWidget#loginRoot QCheckBox#rememberCheck {
    color: #102542; background: transparent; font-size: 19px;
    padding: 0; margin: 0; spacing: 10px;
}
QWidget#loginRoot QCheckBox#rememberCheck::indicator {
    width: 25px; height: 25px; border: 2px solid #183f79;
    border-radius: 5px; background: #e0efff;
}
QWidget#loginRoot QCheckBox#rememberCheck::indicator:checked {
    background: #54cfe7; image: url("@ASSETS@/images/icons/check.svg");
}
QWidget#loginRoot QCheckBox#rememberCheck:focus { color: #005fc9; }
QWidget#loginRoot QCheckBox#rememberCheck::indicator:hover { border-color: #0076d9; }
QWidget#loginRoot QLabel#statusLabel { font-size: 17px; font-weight: 600; }
QWidget#loginRoot QLabel#statusLabel[state="error"] { color: #8b1530; }
QWidget#loginRoot QLabel#statusLabel[state="success"] { color: #075530; }

/* Compact helper dialog owned by Login. Applied again at scale 1 on the dialog. */
QDialog#loginInformationDialog { background: transparent; }
QDialog#loginInformationDialog QFrame#informationCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #142e4b, stop:1 #0e1c30);
    border: 1px solid #395774; border-radius: 20px;
}
QDialog#loginInformationDialog QLabel {
    background: transparent; border: none; margin: 0; padding: 0;
    color: #e7f0fb; font-size: 14px; font-weight: 400;
}
QDialog#loginInformationDialog QLabel#informationIcon {
    background: #183e59; border: 1px solid #31647c; border-radius: 15px;
}
QDialog#loginInformationDialog QLabel#informationEyebrow {
    color: #6fd8eb; font-size: 10px; font-weight: 700;
}
QDialog#loginInformationDialog QLabel#informationTitle {
    color: #ffffff; font-size: 23px; font-weight: 700;
}
QDialog#loginInformationDialog QLabel#informationDescription {
    color: #b3c7dc; font-size: 14px;
}
QDialog#loginInformationDialog QLabel#informationNote {
    background: #20354a; border: 1px solid #3d5265; border-left: 3px solid #ffb348;
    border-radius: 8px; padding: 12px; color: #e7d5b3; font-size: 12px;
}
QDialog#loginInformationDialog QLabel#informationFooter { color: #8ba3bb; font-size: 11px; }
QDialog#loginInformationDialog QPushButton {
    min-height: 0; min-width: 0; padding: 0; margin: 0;
    border: 1px solid transparent; border-radius: 8px;
    font-size: 14px; font-weight: 600;
}
QDialog#loginInformationDialog QPushButton#informationClose {
    color: #b3c8dc; background: transparent; font-size: 24px;
}
QDialog#loginInformationDialog QPushButton#informationClose:hover {
    color: #ffffff; background: #29445e;
}
QDialog#loginInformationDialog QPushButton#informationAccept {
    background: #62d5e9; color: #092d42; padding: 11px 28px; border-radius: 10px;
}
QDialog#loginInformationDialog QPushButton#informationAccept:hover { background: #91e6f3; }
QDialog#loginInformationDialog QPushButton#informationAccept:pressed { background: #34b2cd; }
QDialog#loginInformationDialog QPushButton:focus { border: 1px solid #f1fcff; }
