/* Workspace-only overrides. Login and the shared theme remain independent. */
QFrame#navigationCover { background: #091321; border: none; }
QMainWindow#workspace QLabel#placeholderEyebrow { color: #68c9d8; font-size: 14px; font-weight: 600; }
QMainWindow#workspace QLabel#placeholderTitle { color: #edf4fc; font-size: 28px; font-weight: 700; padding: 10px; }
QMainWindow#workspace QLabel#placeholderHint { color: #95acc3; font-size: 17px; }
QMainWindow#workspace, QWidget#workspaceRoot { background: #091321; }
QFrame#header { background: #101e30; border-bottom: 1px solid #283a50; }
QMainWindow#workspace QLabel#brand { color: #f1f6fc; font-size: 19px; font-weight: 700; }
QMainWindow#workspace QLabel#brandSub { color: #7f9bb5; font-size: 14px; font-weight: 600; }
QMainWindow#workspace QLabel#heading { color: #edf4fc; font-size: 24px; font-weight: 700; }
QMainWindow#workspace QLabel#workspaceSubtitle { color: #8fa6bf; font-size: 14px; }
QMainWindow#workspace QLabel#simulation { color: #efd29a; background: #302a21; border: 1px solid #5c4d33; border-radius: 6px; padding: 5px 9px; font-size: 15px; font-weight: 600; }
QMainWindow#workspace QLabel#connection { background: #162b3d; border: 1px solid #305269; border-radius: 8px; padding: 8px 12px; color: #b5deea; }
QMainWindow#workspace QLabel#workspaceUser { color: #c1d2e3; padding: 0 8px; }
QMainWindow#workspace QLabel#workspaceClock { color: #92a9c2; }
QFrame#sidebar { background: #0d1929; border-right: 1px solid #24354a; }
QFrame#sidebar QPushButton { text-align: left; border: 1px solid transparent; border-radius: 8px; padding: 12px 10px; background: transparent; font-size: 15px; color: #a5b9d0; }
QFrame#sidebar QPushButton:hover { background: #192d43; color: #eaf4ff; }
QFrame#sidebar QPushButton:checked { color: #9feaf4; border: 1px solid #2d5269; border-left: 3px solid #5dd6e6; background: #173348; }
QFrame#sidebar QPushButton:focus { border-color: #7bcedc; }
QFrame#sidebar QPushButton:disabled { color: #61758c; background: transparent; }
QMainWindow#workspace QLabel#sidebarFootnote { color: #8297ae; font-size: 15px; padding: 8px 5px; }
QFrame[panel="true"] { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #13233a,stop:1 #101d2f); border: 1px solid #2a3e56; border-radius: 14px; }
QMainWindow#workspace QLabel[panelTitle="true"] { color: #e1edf8; font-size: 17px; font-weight: 600; border: none; padding-bottom: 3px; }
QLabel[fieldLabel="true"] { color: #9fb4ca; font-size: 14px; }
QMainWindow#workspace QLabel#runningBanner { color: #bbe8ef; border: 1px solid #2b5067; border-left: 4px solid #3a6f88; background: #142e40; border-radius: 8px; padding: 9px 12px; font-weight: 600; }
QMainWindow#workspace QLabel#runningBanner[state="running"] { border-left-color: #38dcf0; background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #133a4d,stop:1 #142e40); }
QMainWindow#workspace QLabel#runningBanner[state="paused"] { color: #ffe2a8; border-color: #6b5530; border-left-color: #f2b84b; background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #3a2f1c,stop:1 #2a2620); }
QMainWindow#workspace QLabel#notice { color: #c8b38c; font-size: 15px; }
QMainWindow#workspace QLabel#verdict { font-size: 24px; font-weight: 700; padding: 6px 8px; }
QMainWindow#workspace QComboBox, QMainWindow#workspace QLineEdit { background: #0c192a; border-color: #354b64; padding: 6px 10px; min-height: 22px; }
QMainWindow#workspace QComboBox { padding-right: 28px; }
QMainWindow#workspace QComboBox:hover, QMainWindow#workspace QLineEdit:hover { border-color: #5e7d97; }
QMainWindow#workspace QComboBox:focus, QMainWindow#workspace QLineEdit:focus { border-color: #66ccdf; }
QMainWindow#workspace QComboBox:disabled, QMainWindow#workspace QLineEdit:disabled { color: #74899f; background: #101b2a; border-color: #293b50; }
QMainWindow#workspace QPushButton { padding: 7px 12px; }
QPushButton#startButton { background: #66d5e5; border: 1px solid #66d5e5; color: #092536; font-weight: 700; }
QPushButton#startButton:hover { background: #92e5ef; border-color: #b6f1f6; }
QPushButton#startButton:pressed { background: #42b7ca; }
QPushButton#stopButton { background: #432633; border: 1px solid #8b4d61; color: #ffbbc7; font-weight: 600; }
QPushButton#stopButton:hover { background: #603246; border-color: #c67a8e; }
QPushButton#startButton:disabled, QPushButton#stopButton:disabled { background: #1a293a; color: #71869b; border-color: #314255; }
QMainWindow#workspace QProgressBar { background: #0b1928; border: 1px solid #354b63; border-radius: 6px; color: #eaf6ff; min-height: 20px; font-size: 15px; }
QMainWindow#workspace QProgressBar::chunk { background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #1f7f98,stop:1 #38c6dc); border-radius: 5px; }
QMainWindow#workspace QTreeView, QMainWindow#workspace QTableView { background: #0c1929; alternate-background-color: #122237; border: 1px solid #293e55; font-size: 14px; gridline-color: #27394e; }
QMainWindow#workspace QHeaderView::section { background: #1a2c42; color: #a9bfd6; padding: 8px; border-color: #2b4058; font-weight: 600; }
QMainWindow#workspace QTreeView::item, QMainWindow#workspace QTableView::item { padding: 6px; }
QMainWindow#workspace QTreeView::item:selected, QMainWindow#workspace QTableView::item:selected { background: #21465d; color: #f3fbff; }
QMainWindow#workspace QTreeView::item:hover, QMainWindow#workspace QTableView::item:hover { background: #1c354b; }
QMainWindow#workspace QSplitter::handle { background: #091321; }
QMainWindow#workspace QSplitter::handle:hover { background: #36536a; }
QMainWindow#workspace QTextBrowser { background: #0e1b2b; border: 1px solid #2d4158; border-radius: 8px; color: #b4c8dc; padding: 5px; }
QChartView#trendView { background: #111f31; border: none; }

/* Persistent connection toolbar and independent acquisition empty state. */
QFrame#connectionBar { background: #0e1c2c; border-bottom: 1px solid #253c51; }
QDialog#connectionDetails QScrollArea { background: #0b1220; border: none; }
QWidget#connectionDetailsContent { background: #0b1220; }
QMainWindow#workspace QLabel#connectionTitle { color: #8eacc3; font-size: 14px; font-weight: 700; padding-right: 8px; }
QMainWindow#workspace QLabel#connectionStatus { color: #93bbc9; font-size: 15px; }
QFrame#connectionBar QComboBox { min-height: 19px; padding-top: 4px; padding-bottom: 4px; }
QPushButton#connectDevice { background: #20495b; color: #b9edf3; border-color: #397389; }
QPushButton#connectDevice:disabled { background: #172738; color: #73899f; border-color: #2b4157; }
QMainWindow#workspace QLabel#runCounts { color: #8daac1; font-size: 15px; }
QFrame#monitorEmpty { background: #0d1b2b; border: 1px dashed #31516a; border-radius: 9px; }
QMainWindow#workspace QLabel#monitorGlyph { color: #47778f; font-size: 30px; padding: 0; }
QMainWindow#workspace QLabel#monitorCaption { color: #bdcfdf; font-size: 15px; font-weight: 600; }
QMainWindow#workspace QLabel#monitorHint { color: #7f9cb4; font-size: 15px; }
QMainWindow#workspace QLabel#monitorSource { color: #7094ae; font-size: 14px; }
QMainWindow#workspace QLabel#monitorValue { color: #70deeb; font-size: 20px; font-weight: 600; }
QPushButton#monitorToggle { padding: 3px 8px; min-height: 18px; font-size: 15px; }

/* Larger workspace typography without changing the accepted login page. */
QMainWindow#workspace QWidget { font-size: 15px; }
QMainWindow#workspace QComboBox QAbstractItemView { font-size: 15px; padding: 3px; }
QMainWindow#workspace QComboBox { combobox-popup: 0; }
QFrame#connectionBar QComboBox::drop-down { width: 28px; background: #20374c; border-left: 1px solid #355369; border-top-right-radius: 6px; border-bottom-right-radius: 6px; }
QFrame#connectionBar QComboBox::down-arrow { image: url("@ASSETS@/images/icons/chevron-down.svg"); width: 16px; height: 16px; }
/* Run controls: Start/Stop (cyan → red), Pause/Resume (amber → green), New session (ghost). */
QMainWindow#workspace QPushButton#startButton { min-height: 26px; min-width: 170px; padding: 10px 20px; border-radius: 10px; font-size: 16px; font-weight: 700; color: #06212f; background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #8be9f4,stop:1 #3fb4cb); border: 1px solid #a6f0f7; border-bottom: 2px solid #2a8ea3; }
QMainWindow#workspace QPushButton#startButton:hover { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #a5f0f8,stop:1 #55c4d8); border-color: #d2fbff; }
QMainWindow#workspace QPushButton#startButton:pressed { background: #33a2b8; border-bottom-width: 1px; padding-top: 11px; }
QMainWindow#workspace QPushButton#startButton[state="running"] { color: #fff3f5; background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #d0566d,stop:1 #93304a); border: 1px solid #f08a9c; border-bottom: 2px solid #6d2236; }
QMainWindow#workspace QPushButton#startButton[state="running"]:hover { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #e0677e,stop:1 #a63a55); border-color: #ffb0be; }
QMainWindow#workspace QPushButton#startButton[state="running"]:pressed { background: #7a2840; border-bottom-width: 1px; padding-top: 11px; }
QMainWindow#workspace QPushButton#startButton:disabled { color: #8ea3b8; background: #22354a; border: 1px solid #344b61; }
QMainWindow#workspace QPushButton#pauseButton { min-height: 26px; min-width: 130px; padding: 10px 16px; border-radius: 10px; font-size: 16px; font-weight: 700; color: #2b1d05; background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffd57a,stop:1 #e5a832); border: 1px solid #ffe2a3; border-bottom: 2px solid #a8761c; }
QMainWindow#workspace QPushButton#pauseButton:hover { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffe39f,stop:1 #f0b94a); border-color: #fff0cc; }
QMainWindow#workspace QPushButton#pauseButton:pressed { background: #cf9426; border-bottom-width: 1px; padding-top: 11px; }
QMainWindow#workspace QPushButton#pauseButton[state="paused"] { color: #04261a; background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #7ff0bf,stop:1 #2fc68a); border: 1px solid #a8f7d4; border-bottom: 2px solid #1d8a5f; }
QMainWindow#workspace QPushButton#pauseButton[state="paused"]:hover { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #a1f6d1,stop:1 #45d79c); }
QMainWindow#workspace QPushButton#pauseButton:disabled { color: #8ea3b8; background: #22354a; border: 1px solid #344b61; }
QMainWindow#workspace QPushButton#newSessionButton { min-height: 26px; min-width: 110px; padding: 10px 16px; border-radius: 10px; font-size: 16px; font-weight: 600; background: #16293d; border: 1px solid #45698a; color: #dceaf8; }
QMainWindow#workspace QPushButton#newSessionButton:hover { background: #22405a; border-color: #86b2cf; }
QMainWindow#workspace QPushButton#newSessionButton:pressed { background: #10233a; }
QMainWindow#workspace QPushButton#newSessionButton:disabled { background: #142235; color: #6d8298; border-color: #2c4258; }
QMainWindow#workspace QPushButton#startButton:focus, QMainWindow#workspace QPushButton#pauseButton:focus, QMainWindow#workspace QPushButton#newSessionButton:focus { border-color: #e0faff; }
QMainWindow#workspace QPushButton#followRunningTest { padding: 7px 14px; border-radius: 8px; background: #16293d; border: 1px solid #3f6482; color: #bfe6f0; font-weight: 600; }
QMainWindow#workspace QPushButton#followRunningTest:hover { background: #20405a; border-color: #6fb4cf; }
QFrame#sidebar QPushButton#closeWorkspace { min-height: 24px; background: #682d3d; color: #ffdce3; border: 1px solid #ad526b; border-radius: 8px; padding: 9px 6px; text-align: center; font-size: 15px; }
QFrame#sidebar QPushButton#closeWorkspace:hover { background: #8e364c; border-color: #e18397; }
QMessageBox#workspaceMessage { background: #111f31; }
QMessageBox#workspaceMessage QLabel { font-size: 16px; }
QMessageBox#workspaceMessage QPushButton { min-width: 86px; font-size: 15px; }
